# ==============================================================================
# Configuracao de Integracao - Cursos EAD (Next.js + Supabase + GitHub Pages)
# ==============================================================================
# Copie este arquivo para .env.local e preencha os valores do seu projeto Supabase.
# Enquanto estiverem vazios, a loja opera 100% no modo estatico local com
# catalogo embutido e matriculas persistidas em localStorage.

# URL publica do projeto Supabase (Project Settings -> API -> Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Chave publica anon/publishable do Supabase (Project Settings -> API -> anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base path opcional (deixe vazio localmente; no GitHub Actions usa /Projeto-Cursos-EAD)
NEXT_PUBLIC_BASE_PATH=
